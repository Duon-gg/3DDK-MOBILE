<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
     android:paddingHorizontal="24dp" android:paddingTop="16dp" android:paddingBottom="32dp">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/collab_title" android:textSize="22sp" android:textStyle="bold" android:accessibilityHeading="true"
      android:textColor="?attr/colorOnSurface"/>
  <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:paddingBottom="16dp" android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant"/>

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/collab_invite_email"
      android:textStyle="bold" android:textSize="15sp" android:paddingBottom="8dp" android:accessibilityHeading="true" android:textColor="?attr/colorOnSurface"/>
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/email_box" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/p0_email_duoc_moi">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent"
       android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textEmailAddress" android:maxLines="1"/>
  </com.google.android.material.textfield.TextInputLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="8dp">
   <Spinner android:id="@+id/email_role" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
       android:contentDescription="@string/collab_role"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/invite" android:layout_width="wrap_content"
       android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/collab_send_invite"/>
  </LinearLayout>

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/collab_link_title"
      android:textStyle="bold" android:textSize="15sp" android:paddingTop="24dp" android:accessibilityHeading="true" android:textColor="?attr/colorOnSurface"/>
  <TextView android:id="@+id/link_state" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:paddingVertical="8dp" android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant" android:accessibilityLiveRegion="polite"/>
  <Spinner android:id="@+id/link_role" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/collab_role"/>
  <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/link_actions" android:layout_width="match_parent" android:layout_height="wrap_content">
   <com.google.android.material.button.MaterialButton android:id="@+id/link_create" style="@style/Widget.Material3.Button.OutlinedButton"
       android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/collab_link_create"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/link_share" style="@style/Widget.Material3.Button.OutlinedButton"
       android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/collab_link_share"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/link_off" style="@style/Widget.Material3.Button.OutlinedButton"
       android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/collab_link_off"/>
  </com.google.android.material.button.MaterialButtonToggleGroup>

  <TextView android:id="@+id/people_title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textStyle="bold" android:textSize="15sp" android:paddingTop="24dp" android:paddingBottom="8dp" android:accessibilityHeading="true" android:textColor="?attr/colorOnSurface"/>
  <LinearLayout android:id="@+id/people" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 </LinearLayout>
</ScrollView>
