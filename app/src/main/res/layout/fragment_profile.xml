<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent"><ScrollView android:fillViewport="true" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
 <ImageView android:id="@+id/avatar" android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="8dp" android:layout_gravity="center_horizontal" android:contentDescription="Ảnh đại diện"/>
 <TextView android:id="@+id/display_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/mobile_text"/>
 <TextView android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/mobile_text" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="24dp" android:textIsSelectable="true"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/edit_profile" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="start|center_vertical" android:text="@string/profile_edit" android:textColor="@color/mobile_text" app:icon="@drawable/ic_profile_outline" app:iconTint="@color/mobile_text" app:iconPadding="16dp" android:textSize="16sp" android:fontFamily="sans-serif" app:iconSize="24dp" android:paddingStart="8dp" android:paddingEnd="8dp"/>
 <LinearLayout android:id="@+id/profile_editor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
 <com.google.android.material.button.MaterialButton android:id="@+id/change_avatar" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chọn avatar"/>

 <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tên hiển thị"><com.google.android.material.textfield.TextInputEditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLength="100"/></com.google.android.material.textfield.TextInputLayout>
 <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lưu hồ sơ"/>
</LinearLayout>
 <com.google.android.material.button.MaterialButton android:gravity="start|center_vertical" android:textColor="@color/mobile_text" android:id="@+id/change_password" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:text="@string/password_change" android:visibility="gone" app:icon="@drawable/ic_password_outline" app:iconTint="@color/mobile_text" app:iconPadding="16dp" android:textSize="16sp" android:fontFamily="sans-serif" app:iconSize="24dp" android:paddingStart="8dp" android:paddingEnd="8dp"/>
 <TextView android:visibility="gone" android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/notifications" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cài đặt thông báo"/>
 <com.google.android.material.button.MaterialButton android:gravity="start|center_vertical" android:minHeight="60dp" android:textColor="@color/mobile_text" android:id="@+id/logout" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đăng xuất" android:layout_marginTop="8dp" app:icon="@drawable/ic_logout_outline" app:iconTint="@color/mobile_text" app:iconPadding="16dp" android:textSize="16sp" android:fontFamily="sans-serif" app:iconSize="24dp" android:paddingStart="8dp" android:paddingEnd="8dp"/>
 <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 <TextView android:id="@+id/build_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="48dp" android:paddingBottom="16dp" android:textSize="12sp" android:textColor="@color/mobile_secondary_text"/>
</LinearLayout></ScrollView></androidx.constraintlayout.widget.ConstraintLayout>
