<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
 <LinearLayout android:id="@+id/home_header" android:layout_width="0dp" android:layout_height="80dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <ImageButton android:id="@+id/home_profile" android:layout_width="48dp" android:layout_height="48dp" android:padding="5dp" android:src="@drawable/ic_app" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/home_profile_label"/>
  <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
  <ImageButton android:id="@+id/home_add" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_home_add" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/p0_tao_khong_gian"/>
  <ImageButton android:id="@+id/header_search" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_home_search_outline" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/p0_tim_ten"/>
  <ImageButton android:id="@+id/home_invitations" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_home_bell_outline" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/p0_loi_moi_tham_gia"/>
  <ImageButton android:id="@+id/home_more" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_workspace_more" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/home_more_options"/>
 </LinearLayout>
 <TextView android:id="@+id/heading" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" android:accessibilityHeading="true" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/home_header" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <TextView android:id="@+id/sync" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:accessibilityLiveRegion="polite" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/heading" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <com.google.android.material.textfield.TextInputLayout android:id="@+id/search_box" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/p0_tim_ten" android:visibility="gone" app:startIconDrawable="@drawable/ic_home_search_outline" app:boxCornerRadiusTopStart="8dp" app:boxCornerRadiusTopEnd="8dp" app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusBottomEnd="8dp" app:layout_constraintTop_toBottomOf="@id/actions" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <com.google.android.material.textfield.TextInputEditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:maxLines="1" android:textSize="16sp"/>
 </com.google.android.material.textfield.TextInputLayout>
 <LinearLayout android:id="@+id/actions" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/sync" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <ImageButton android:id="@+id/home_search" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/p0_tim_ten" android:src="@drawable/ic_home_search_outline" app:tint="?attr/colorOnSurface"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/p0_lam_moi"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/add" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="@string/p0_tao_khong_gian" app:cornerRadius="8dp"/>
 </LinearLayout>
 <HorizontalScrollView android:id="@+id/home_tab_scroll" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" android:scrollbars="none" app:layout_constraintTop_toBottomOf="@id/search_box" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
 <com.google.android.material.button.MaterialButtonToggleGroup
     android:id="@+id/home_tabs" android:layout_width="wrap_content" android:layout_height="wrap_content"
     android:visibility="gone" android:baselineAligned="false"
     app:singleSelection="true" app:selectionRequired="true"
     >
  <com.google.android.material.button.MaterialButton android:id="@+id/recent_tab" style="@style/Widget.Material3.Button.TextButton" android:foreground="@drawable/home_tab_underline" android:textColor="?attr/colorOnSurface" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp"
      android:layout_width="wrap_content" android:minWidth="72dp" android:layout_height="wrap_content" android:minHeight="48dp" android:textSize="14sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="12dp" android:text="@string/home_recent"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/starred_tab" style="@style/Widget.Material3.Button.TextButton" android:foreground="@drawable/home_tab_underline" android:textColor="?attr/colorOnSurface" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp"
      android:layout_width="wrap_content" android:minWidth="72dp" android:layout_height="wrap_content" android:minHeight="48dp" android:textSize="14sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="12dp" android:text="@string/home_starred"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/spaces_tab" style="@style/Widget.Material3.Button.TextButton" android:foreground="@drawable/home_tab_underline" android:textColor="?attr/colorOnSurface" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp"
      android:layout_width="wrap_content" android:minWidth="72dp" android:layout_height="wrap_content" android:minHeight="48dp" android:textSize="14sp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="12dp" android:text="@string/home_spaces"/>
 </com.google.android.material.button.MaterialButtonToggleGroup>
 </HorizontalScrollView>
 <com.google.android.material.button.MaterialButton android:id="@+id/pending_invites" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:visibility="gone" android:gravity="start|center_vertical" app:icon="@drawable/ic_person_add" app:layout_constraintTop_toBottomOf="@id/home_tab_scroll" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <TextView android:id="@+id/summary" android:layout_width="0dp" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/pending_invites" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingTop="10dp" android:paddingBottom="16dp" app:layout_constraintTop_toBottomOf="@id/summary" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <TextView android:id="@+id/empty" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:textSize="15sp" android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/p0_chua_co_du_lieu_da_tai_ket_noi" app:layout_constraintTop_toBottomOf="@id/summary" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
