<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="24dp">
 <ImageView android:id="@+id/illustration" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/welcome_workspace" android:importantForAccessibility="no"/>
 <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/mobile_text"/>
 <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textColor="@color/mobile_secondary_text" android:layout_marginTop="8dp" android:paddingBottom="16dp"/>
</LinearLayout>
