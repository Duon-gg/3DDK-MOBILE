<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:layout_marginStart="12dp"
    android:orientation="vertical" android:clickable="true" android:focusable="true"
    android:background="@drawable/grid_record_background" android:clipToOutline="true">
    <TextView android:id="@+id/title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="30dp"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant" android:maxLines="1"
        android:ellipsize="end" android:gravity="center_vertical"
        android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/cells" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:baselineAligned="false" />
</LinearLayout>
